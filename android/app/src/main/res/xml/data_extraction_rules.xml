<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup nel cloud e passaggio a un telefono nuovo, con i dati della WebView (i progressi) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
