<?xml version="1.0" encoding="utf-8"?>
<!-- widget «Oggi» grande, versione stretta (meno di ~280 dp), stile «Giada»: tutto in colonna -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="11dp" android:background="@drawable/w_giada_afternoon">
    <LinearLayout android:id="@+id/w_segs" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginBottom="6dp" android:orientation="horizontal">
        <ImageView android:id="@+id/w_s0" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s1" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s2" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s3" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s4" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s5" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s6" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s7" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s8" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_s9" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:src="@drawable/w_seg_off" android:scaleType="fitXY" android:importantForAccessibility="no" />
    </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
                <TextView android:id="@+id/w_seal" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/w_seal" android:text="调" android:textColor="#FFF6EA" android:textSize="22sp" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/w_icon" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_g_sun" android:visibility="gone" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                    android:text="@string/w_sample_msg" android:textColor="@color/w_g_text" android:textSize="13sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/w_flame" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_g_flame" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_streak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:maxLines="1" android:ellipsize="end"
                        android:text="@string/w_sample_streak" android:textColor="@color/w_g_mute" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_word" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp"
            android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/w_glass">
            <TextView android:id="@+id/w_hz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="@string/w_sample_hz" android:textColor="@color/w_g_text" android:textSize="24sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
                <TextView android:id="@+id/w_py" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                    android:text="@string/w_sample_py" android:textColor="@color/w_g_mint" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                    android:text="@string/w_sample_it" android:textColor="@color/w_g_mute" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    <LinearLayout android:id="@+id/w_right" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_due_n" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/w_sample_n" android:textColor="@color/w_g_mint" android:textSize="24sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView android:id="@+id/w_due_l" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="@string/w_sample_label" android:textColor="@color/w_g_text" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_due_d" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="@string/w_sample_detail" android:textColor="@color/w_g_mute" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_study" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="48dp"
            android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/w_btn_giada" android:text="@string/w_study"
            android:textColor="@color/w_g_on_orange" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
